server {
    listen 80;
    server_name myserver.test;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name myserver.test;

    ssl_certificate     /etc/nginx/ssl/myserver.test.crt;
    ssl_certificate_key /etc/nginx/ssl/myserver.test.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
}
